# systemd user unit for the status service. Copy to ~/.config/systemd/user/,
# fix the path to agent-status.mjs, then:
#   systemctl --user daemon-reload && systemctl --user enable --now agent-status
[Unit]
Description=T3 Things status service
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/bin/env node %h/t3-things/service/agent-status.mjs
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
